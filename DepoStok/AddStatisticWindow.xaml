<Window x:Class="DepoStok.AddStatisticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İstatistik seç"
        Height="420" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="OkButton"
                    Content="Ekle"
                    Width="90" Height="30"
                    IsEnabled="False"
                    Click="OkButton_Click" />
            <Button Content="İptal"
                    Width="90" Height="30"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="Önce bir ürün cinsi, sonra kartın başlığında görünecek özelliği seçin."
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Ürün cinsi"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />
                <ListBox x:Name="TypeList"
                         DisplayMemberPath="Name"
                         SelectionChanged="TypeList_SelectionChanged" />
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="Özellik"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />
                <ListBox x:Name="PropertyList"
                         DisplayMemberPath="Name"
                         SelectionChanged="PropertyList_SelectionChanged" />
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
