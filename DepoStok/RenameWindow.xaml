<Window x:Class="DepoStok.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adı değiştir"
        Height="210" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Tamam"
                    Width="90" Height="30"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="İptal"
                    Width="90" Height="30"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

        <!-- ÜST: BAŞLIK VE YENİ AD KUTUSU -->
        <TextBlock x:Name="HeadingText"
                   DockPanel.Dock="Top"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <TextBlock DockPanel.Dock="Top"
                   Text="Yeni ad:"
                   Margin="0,0,0,5" />

        <TextBox x:Name="NameBox"
                 DockPanel.Dock="Top"
                 Height="28"
                 MaxLength="50"
                 VerticalContentAlignment="Center" />

    </DockPanel>
</Window>
