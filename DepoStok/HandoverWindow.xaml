<Window x:Class="DepoStok.HandoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teslim-Tesellüm Tutanağı"
        Height="620" Width="780"
        MinHeight="480" MinWidth="650"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Yazdır"
                    Width="100" Height="30"
                    Margin="0,0,8,0"
                    Click="PrintButton_Click" />
            <Button Content="Kapat"
                    Width="90" Height="30"
                    IsCancel="True" />
        </StackPanel>

        <!-- ÜST: BİRİM VE TARİH BİLGİLERİ -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">

            <TextBlock Text="DEMİRBAŞ / TÜKETİM MALZEME TESLİM TUTANAĞI"
                       FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Teslim Eden Birim:"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="FromUnitBox"
                         Grid.Column="1"
                         Height="26" Margin="6,0,10,0"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="Kategori:"
                           Grid.Column="2"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="CategoryBox"
                         Grid.Column="3"
                         Height="26" Margin="6,0,0,0"
                         Text="DEMİRBAŞ"
                         VerticalContentAlignment="Center" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Teslim Alan Birim:"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="ToUnitBox"
                         Grid.Column="1"
                         Height="26" Margin="6,0,10,0"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="Tarih:"
                           Grid.Column="2"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Name="DateText"
                           Grid.Column="3"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>

        </StackPanel>

        <!-- ORTA: MALZEME TABLOSU (Excel gibi: son satıra yazınca yeni satır eklenir) -->
        <DataGrid x:Name="ItemsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Seri No"
                                    Binding="{Binding SerialNo, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140" />
                <DataGridTextColumn Header="Malzemenin cinsi"
                                    Binding="{Binding ItemType, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
                <DataGridTextColumn Header="Miktarı"
                                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80" />
                <DataGridTextColumn Header="Düşünceler"
                                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                    Width="180" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>