<Window x:Class="DepoStok.AssignmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zimmetler"
        Height="560" Width="950"
        MinHeight="400" MinWidth="750"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ÜST: ARAMA VE KAYIT SAYISI -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="CountText"
                       DockPanel.Dock="Right"
                       Foreground="Gray"
                       VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left"
                       Text="Ara (kişi, sicil, birim, ürün):"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Margin="0,0,15,0"
                     TextChanged="SearchBox_TextChanged" />
        </DockPanel>

        <!-- ALT: KAPAT -->
        <Button DockPanel.Dock="Bottom"
                Content="Kapat"
                Width="90" Height="30"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                IsCancel="True" />

        <!-- ORTA: ZİMMET LİSTESİ (en yeni en üstte) -->
        <DataGrid x:Name="AssignmentsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ürün tipi"
                                    Binding="{Binding TypeName}"
                                    Width="110" />
                <DataGridTextColumn Header="Ürün"
                                    Binding="{Binding ProductDescription}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Miktar"
                                    Binding="{Binding Quantity}"
                                    Width="60" />
                <DataGridTextColumn Header="Kişi"
                                    Binding="{Binding PersonName}"
                                    Width="140" />
                <DataGridTextColumn Header="Sicil"
                                    Binding="{Binding RegistryNo}"
                                    Width="90" />
                <DataGridTextColumn Header="Birim"
                                    Binding="{Binding Department}"
                                    Width="120" />
                <DataGridTextColumn Header="Zimmet tarihi"
                                    Binding="{Binding AssignedAtText}"
                                    Width="140" />
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Yazdır"
                                    Width="70" Height="26"
                                    Click="PrintButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="İade Al"
                                    Width="80" Height="26"
                                    Click="ReturnButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>