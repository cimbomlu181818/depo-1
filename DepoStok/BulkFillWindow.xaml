<Window x:Class="DepoStok.BulkFillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boş alanları doldur"
        Height="400" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="FillButton"
                    Content="Doldur"
                    Width="90" Height="30"
                    IsDefault="True"
                    Click="FillButton_Click" />
            <Button Content="Kapat"
                    Width="90" Height="30"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

        <!-- ÜST: KAPSAM (hangi ürünler etkilenecek) -->
        <TextBlock x:Name="ScopeText"
                   DockPanel.Dock="Top"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <!-- DOLDURULACAK ALAN -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Doldurulacak alan"
                   Margin="0,0,0,5" />

        <ComboBox x:Name="PropertyBox"
                  DockPanel.Dock="Top"
                  Height="28"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,12"
                  SelectionChanged="PropertyBox_SelectionChanged" />

        <!-- YAZILACAK DEĞER (alanın türüne göre kutu, tarih seçici ya da onay kutusu gelir) -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Yazılacak değer"
                   Margin="0,0,0,5" />

        <ContentControl x:Name="ValueHolder"
                        DockPanel.Dock="Top"
                        MinHeight="28"
                        Margin="0,0,0,12" />

        <!-- BİLGİ -->
        <TextBlock x:Name="InfoText"
                   DockPanel.Dock="Top"
                   Foreground="Gray"
                   TextWrapping="Wrap" />

    </DockPanel>
</Window>
