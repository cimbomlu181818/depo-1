<Window x:Class="DepoStok.ScrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hurda"
        Height="560" Width="950"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SOL BÖLÜM: hurdada ürünü olan ürün cinsleri -->
        <DockPanel Grid.Column="0" Margin="10">

            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button x:Name="RestoreButton"
                        Content="Normale Geri Al"
                        Height="32"
                        Margin="0,0,0,8"
                        Click="RestoreButton_Click" />
                <Button Content="Kapat"
                        Height="32"
                        IsCancel="True" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Top"
                       Text="Hurdadaki ürün cinsleri"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5" />

            <ListBox x:Name="ScrapTypeList"
                     SelectionChanged="ScrapTypeList_SelectionChanged" />

        </DockPanel>

        <!-- ORTA BÖLÜM: hurda ürünler (Excel görünümü) -->
        <DockPanel Grid.Column="1" Margin="0,10,10,10">

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="CountText"
                           DockPanel.Dock="Right"
                           Foreground="Gray"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText"
                           FontSize="16"
                           FontWeight="SemiBold" />
            </DockPanel>

            <DataGrid x:Name="ProductGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      FrozenColumnCount="2"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All" />

        </DockPanel>
    </Grid>
</Window>