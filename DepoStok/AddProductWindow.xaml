<Window x:Class="DepoStok.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürün ekle"
        Height="260" Width="760"
        MinWidth="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: KAYDET / İPTAL -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Kaydet"
                    Width="90" Height="30"
                    IsDefault="True"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click" />
            <Button Content="İptal"
                    Width="90" Height="30"
                    IsCancel="True" />
        </StackPanel>

        <TextBlock x:Name="TitleText"
                   DockPanel.Dock="Top"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5" />

        <TextBlock x:Name="HintText"
                   DockPanel.Dock="Top"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <!-- ALANLAR YATAYDA: başlık üstte, giriş kutusu altta -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FieldsPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Top" />
        </ScrollViewer>

    </DockPanel>
</Window>