<Window x:Class="DepoStok.DeleteProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ürünleri sil"
        Height="380" Width="520"
        MinHeight="260" MinWidth="400"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: ONAY / İPTAL -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="ConfirmButton"
                    Content="Sil"
                    Width="110" Height="30"
                    Margin="0,0,8,0"
                    Click="ConfirmButton_Click" />
            <Button Content="İptal"
                    Width="90" Height="30"
                    IsCancel="True" />
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   DockPanel.Dock="Top"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,5" />

        <TextBlock x:Name="HintText"
                   DockPanel.Dock="Top"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <Border BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ItemsPanel" Margin="8" />
            </ScrollViewer>
        </Border>

    </DockPanel>
</Window>