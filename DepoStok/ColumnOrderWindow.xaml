<Window x:Class="DepoStok.ColumnOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sütun düzenle"
        Height="440" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Kaydet"
                    Width="90" Height="30"
                    Click="SaveButton_Click" />
            <Button Content="Kapat"
                    Width="90" Height="30"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="Alanların soldan sağa sırası. Değiştirmek için seçip Yukarı/Aşağı kullanın."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <!-- SAĞ: YUKARI / AŞAĞI -->
        <StackPanel DockPanel.Dock="Right"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center">
            <Button x:Name="MoveUpButton"
                    Content="Yukarı"
                    Width="80" Height="30"
                    Margin="0,0,0,8"
                    Click="MoveUpButton_Click" />
            <Button x:Name="MoveDownButton"
                    Content="Aşağı"
                    Width="80" Height="30"
                    Click="MoveDownButton_Click" />
        </StackPanel>

        <ListBox x:Name="PropertyList" />

    </DockPanel>
</Window>
