<Window x:Class="DepoStok.AssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zimmetle"
        Height="440" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ALT: DÜĞMELER -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Zimmetle"
                    Width="90" Height="30"
                    IsDefault="True"
                    Click="AssignButton_Click" />
            <Button Content="İptal"
                    Width="90" Height="30"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

        <StackPanel>

            <TextBlock x:Name="ProductText"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

            <TextBlock x:Name="AvailableText"
                       Foreground="Gray"
                       Margin="0,0,0,15" />

            <TextBlock Text="Kişi adı soyadı *"
                       Margin="0,0,0,5" />
            <TextBox x:Name="PersonNameBox"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12" />

            <TextBlock Text="Sicil no"
                       Margin="0,0,0,5" />
            <TextBox x:Name="RegistryNoBox"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12" />

            <TextBlock Text="Birim"
                       Margin="0,0,0,5" />
            <TextBox x:Name="DepartmentBox"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12" />

            <TextBlock x:Name="QuantityLabel"
                       Text="Miktar"
                       Margin="0,0,0,5" />
            <TextBox x:Name="QuantityBox"
                     Height="28"
                     Width="80"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,12" />

            <TextBlock Text="Not (isteğe bağlı)"
                       Margin="0,0,0,5" />
            <TextBox x:Name="NoteBox"
                     Height="50"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />

        </StackPanel>

    </DockPanel>
</Window>
