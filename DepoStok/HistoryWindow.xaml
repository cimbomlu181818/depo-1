<Window x:Class="DepoStok.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İşlem geçmişi"
        Height="560" Width="950"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <!-- ÜST: ARAMA VE KAYIT SAYISI -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="CountText"
                       DockPanel.Dock="Right"
                       Foreground="Gray"
                       VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left"
                       Text="Ara:"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox"
                     Height="28"
                     VerticalContentAlignment="Center"
                     Margin="0,0,15,0"
                     TextChanged="SearchBox_TextChanged" />
        </DockPanel>

        <!-- ALT: KAPAT -->
        <Button DockPanel.Dock="Bottom"
                Content="Kapat"
                Width="90" Height="30"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                IsCancel="True" />

        <!-- ORTA: İŞLEM LİSTESİ (en yeni en üstte) -->
        <DataGrid x:Name="HistoryGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zaman"
                                    Binding="{Binding TimeText}"
                                    Width="150" />
                <DataGridTextColumn Header="Kullanıcı"
                                    Binding="{Binding UserName}"
                                    Width="110" />
                <DataGridTextColumn Header="İşlem"
                                    Binding="{Binding Action}"
                                    Width="190" />
                <DataGridTextColumn Header="Ayrıntı"
                                    Binding="{Binding Details}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
